[Unit]
Description=PiCCTV surveillance server
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=-/etc/pi-cctv.env
ExecStart=/usr/local/bin/surveillance
Restart=always
RestartSec=2
DynamicUser=yes
StateDirectory=pi-cctv
SupplementaryGroups=video
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
